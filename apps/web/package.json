{
  "name": "@meridian/web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/sync-brand.mjs && ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "node scripts/sync-brand.mjs && ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "brand": "node scripts/sync-brand.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@jsverse/transloco": "8.4.0",
    "@meridian/shared": "workspace:*",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
