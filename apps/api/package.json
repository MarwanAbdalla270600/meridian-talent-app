{
  "name": "@meridian/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --timeout 30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "jobs:retention": "bun src/modules/gdpr/run-retention.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@meridian/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "mammoth": "1.13.0",
    "nodemailer": "10.3.1",
    "otpauth": "9.6.0",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "unpdf": "2.1.0"
  }
}
