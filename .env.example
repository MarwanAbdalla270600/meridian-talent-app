# =============================================================================
# Meridian Talent – configuration template
# Copy to `.env` (development) or `deploy/.env.prod` (production) and fill in.
# The API validates every variable on start and refuses to start on errors.
# Never commit real values.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Public origin of the app (used for CORS/CSRF origin checks and e-mail links).
# Production: https://talent.example.at
BASE_URL=http://localhost:4200
# Set to true when running behind Caddy (reads X-Forwarded-For for rate limits/audit IPs).
TRUST_PROXY=false
# Serve OpenAPI JSON and Swagger UI under /api/docs (keep false in production).
API_DOCS_ENABLED=true

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
DATABASE_POOL_MAX=10
# Used by the production compose file for the postgres container.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian

# --- Sessions & crypto -------------------------------------------------------
# >= 32 random characters:  openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# 32 random bytes, base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWNoYW5nZS1tZSE=
# Must be true in production (HTTPS). false only for plain-http local development.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# --- S3-compatible storage (MinIO in dev, EU region in production) -----------
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in pre-signed download URLs (must be reachable by the browser).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=meridian-documents
S3_ACCESS_KEY_ID=meridian
S3_SECRET_ACCESS_KEY=meridian-dev-secret
S3_FORCE_PATH_STYLE=true
# Create the bucket on start if missing (dev only).
S3_AUTO_CREATE_BUCKET=true
# Validity of pre-signed download URLs in seconds.
S3_PRESIGN_SECONDS=60

# --- E-mail ------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Meridian Talent <no-reply@meridian-talent.example>"

# --- CV import (Anthropic API) -----------------------------------------------
# Feature flag: AI extraction of uploaded CVs. When false, uploads still work and
# users fill the profile manually.
FEATURE_CV_AI_IMPORT=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional alternative endpoint (e.g. a regional/zero-retention gateway).
ANTHROPIC_BASE_URL=
# Server-side refusal fallbacks (beta). Set false when using a gateway that rejects it.
ANTHROPIC_FALLBACKS=true
# Optional inference geography (only values supported by the API; see docs/dsgvo.md).
ANTHROPIC_INFERENCE_GEO=
CV_IMPORT_TIMEOUT_MS=90000

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=10
# Optional ClamAV daemon for virus scanning (INSTREAM). Empty = scan skipped (logged).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- PDF rendering -----------------------------------------------------------
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=30000
PDF_QUEUE_MAX=20

# --- Data protection ---------------------------------------------------------
RETENTION_JOB_ENABLED=true
# Defaults written to the settings table on first start (editable by admins).
RETENTION_MONTHS=24
CONSENT_GRACE_DAYS=30
REQUIRE_TOTP_FOR_PRIVILEGED=false

# --- Seed (development / first production start only) ------------------------
# Demo users are created only if these are set. Use strong passwords.
SEED_ADMIN_EMAIL=admin@meridian.local
SEED_ADMIN_PASSWORD=
SEED_AUSTRIA_EMAIL=austria@meridian.local
SEED_AUSTRIA_PASSWORD=
SEED_EGYPT_EMAIL=egypt@meridian.local
SEED_EGYPT_PASSWORD=
# Also create fictional demo developers, clients and requests.
SEED_DEMO_DATA=false

# --- Production deployment (deploy/docker-compose.prod.yml) ------------------
# Domain served by Caddy (automatic HTTPS via Let's Encrypt).
DOMAIN=talent.example.at
ACME_EMAIL=ops@example.at
# Image tag to deploy (ghcr.io/<owner>/meridian-talent-{api,web}:<tag>).
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
# age public key used to encrypt nightly database backups (age-keygen).
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
